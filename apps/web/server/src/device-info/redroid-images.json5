// The redroid images that devices are made from.
//
// This is the file to edit. `pnpm catalog:generate` writes redroid-images.json
// from it, which the code imports and git ignores; the dev, build,
// server:build, test and type-check scripts run it first.
//
// It keeps the JSON style of the redroid-images.json it was renamed from
// (quoted keys, no trailing commas), so that git blame follows its lines back.
//
// A device stores its image's imageName, so an entry is never removed and its
// imageName never changes. An image that is no longer offered is kept with
// `usable: false`, and the reason beside it:
//   - no audio: audio passthrough needs Android 12 (see redroid-images.test.ts)
//
// The fields are described in redroid-images.ts.
[
  {
    "name": "AOSP Android 14",
    "description": "Android Open Source Project (AOSP) Android 14.0.0. No Play Store.",
    "imageName": "redroid/redroid:14.0.0-latest",
    "usable": true,
    "premium": true,
    "gms": false,
    "androidSdkVersion": 34
  },
  {
    "name": "AOSP Android 13",
    "description": "Android Open Source Project (AOSP) Android 13.0.0. No Play Store.",
    "imageName": "redroid/redroid:13.0.0-latest",
    "usable": true,
    "premium": true,
    "gms": false,
    "androidSdkVersion": 33
  },
  {
    "name": "AOSP Android 12",
    "description": "Android Open Source Project (AOSP) Android 12.0.0 (non-L). No Play Store.",
    "imageName": "redroid/redroid:12.0.0-latest",
    "usable": true,
    "premium": false,
    "gms": false,
    "androidSdkVersion": 31
  },
  {
    "name": "AOSP Android 11",
    "description": "Android Open Source Project (AOSP) Android 11.0.0. No Play Store. Audio is not supported using this image.",
    "imageName": "redroid/redroid:11.0.0-latest",
    "usable": false, // no audio
    "premium": false,
    "gms": false,
    "androidSdkVersion": 30
  },
  {
    "name": "AOSP Android 10",
    "description": "Android Open Source Project (AOSP) Android 10.0.0. No Play Store. Audio is not supported using this image.",
    "imageName": "redroid/redroid:10.0.0-latest",
    "usable": false, // no audio
    "premium": false,
    "gms": false,
    "androidSdkVersion": 29
  },
  {
    "name": "AOSP Android 9",
    "description": "Android Open Source Project (AOSP) Android 9.0.0. No Play Store. Audio is not supported using this image.",
    "imageName": "redroid/redroid:9.0.0-latest",
    "usable": false, // no audio
    "premium": false,
    "gms": false,
    "androidSdkVersion": 28
  },
  {
    "name": "AOSP Android 8.1",
    "description": "Android Open Source Project (AOSP) Android 8.1.0. No Play Store. Audio is not supported using this image.",
    "imageName": "redroid/redroid:8.1.0-latest",
    "usable": false, // no audio
    "premium": false,
    "gms": false,
    "androidSdkVersion": 27
  },
  {
    "name": "Play Store Android 11",
    "description": "Android 11 with the Play Store installed, fully-featured and ready to go. Audio is not supported using this image.",
    "imageName": "abing7k/redroid:a11_gapps_arm",
    "usable": false, // no audio
    "premium": false,
    "gms": true,
    "androidSdkVersion": 30
  },
  {
    "name": "Play Store Android 10",
    "description": "Android 10 with the Play Store installed, fully-featured and ready to go. Audio is not supported using this image.",
    "imageName": "cr.regulad.xyz/regulad/redroid-script:10.0.0-gapps-latest",
    "usable": false, // no audio
    "premium": false,
    "gms": true,
    "androidSdkVersion": 29
  },

  {
    "name": "Play Store Android 12",
    "description": "Android 12 (non-L) with the Play Store installed, fully-featured and ready to go.",
    "imageName": "cr.regulad.xyz/regulad/redroid-script:12.0.0-gapps-latest",
