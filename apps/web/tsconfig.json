{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "target": "ES2023",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "incremental": true,
    // TypeScript 6 no longer loads every installed @types package; these are
    // the ones that declare globals: Node's, Jest's, and *.mdx imports
    "types": ["node", "jest", "mdx"],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "contentlayer/generated": ["./.contentlayer/generated"],
      "@/*": ["./src/*"],
      "%/*": ["./server/src/*"]
    }
  },
  "ts-node": {
    "esm": true
  },
  "include": [
    "next-env.d.ts",
    "*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "server/**/*.ts",
    "src/app/**/*.ts",
    "src/components/**/*.ts",
    "src/lib/**/*.ts",
    "src/pages/**/*.ts",
    "src/utils/**/*.ts",
    "src/*.ts",
    "src/*.d.ts",
    ".contentlayer/generated",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", "src/ws-scrcpy/**/*.ts"]
}
