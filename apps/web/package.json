  "scripts": {
    "init": "git submodule update --init --recursive",
    "android:fetch": "bash scripts/download-scrcpy-server.sh & bash scripts/download-android-apps.sh",
    "db:generate": "prisma generate",
    "catalog:generate": "node scripts/generate-redroid-images.mjs",
    "db:migrate": "dotenvx run --env-file=.env.local -- prisma migrate dev",
    "db:seed": "dotenvx run --env-file=.env.local -- tsx prisma/seed.ts",
    "server:build": "pnpm run catalog:generate && pkgroll --minify --src server/src --tsconfig=server/tsconfig.json --clean-dist --sourcemap && ((sentry-cli releases --org regulad --project doppelganger new ${SENTRY_RELEASE:-$(git rev-parse HEAD || echo \"unknown\")} && sentry-cli sourcemaps inject dist && sentry-cli sourcemaps --org regulad --project doppelganger upload dist && sentry-cli releases --org regulad --project doppelganger finalize ${SENTRY_RELEASE:-$(git rev-parse HEAD || echo \"unknown\")}) || (echo \"WARNING: Couldn't upload sentry sourcemap.\" && test -z \"$SENTRY_AUTH_TOKEN\"))",
    "android:dev": "bash scripts/android-dev.sh",
    "dev": "pnpm run catalog:generate && tsx server/src/index.ts",
    "workers:dev": "rimraf -rf public/workers/ && webpack --config workers/webpack.config.cjs",
    "workers:build": "rimraf -rf public/workers/ && webpack --config workers/webpack.config.cjs --mode production",
    "licenses:check": "node scripts/generate-licenses.mjs \"src/app/(userland)/(contained)/licenses/licenses.json\" public/third-party-notices.txt",
    "build": "pnpm run catalog:generate && next build --webpack && next-sitemap --config next-sitemap.config.mjs",
    "start": "prisma migrate deploy && pm2 start ecosystem.config.json --no-daemon",
    "lint": "eslint --max-warnings 0 src",
    "type-check": "pnpm run catalog:generate && pnpm run db:generate && pnpm run licenses:check && tsc --noEmit --project tsconfig.json",
    "test": "pnpm run catalog:generate && jest",
    "test:watch": "pnpm run catalog:generate && jest --watch",
    "ui:add": "pnpx shadcn-ui@latest add"
  }
